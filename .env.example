# Temporal
TEMPORAL_HOST=localhost:7233

# MCP Server (Area A) — port 8081 to avoid conflict with Temporal web UI on 8080
MCP_SERVER_URL=http://localhost:8081
MCP_API_KEY=dev-key

# LLM (Area A — analyze_root_cause)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# or if using OpenAI:
OPENAI_API_KEY=

# Public demo URL — keep AI on but cap spend (see README)
# OPENAI_DAILY_RCA_MAX=40
# OPENAI_DAILY_NARRATIVE_MAX=25
# DEMO_TRIGGER_MAX_PER_IP_HOUR=4
# DEMO_TRIGGER_MAX_GLOBAL_DAY=30
# DEMO_NARRATIVE_MAX_PER_IP_HOUR=6
# DEMO_ASK_MAX_PER_IP_HOUR=6
# DEMO_TRIGGER_PASSCODE=pick-a-secret-for-judges

# Dashboard
DASHBOARD_PORT=7080

# Mock Services (Area C)
MOCK_SERVICES_URL=http://localhost:9090
MOCK_SERVICES_PORT=9090
PAYMENT_FAILURE_RATE=0.3   # 30% chance of simulated payment failure
MOCK_DB_PATH=mock_services.db  # set to :memory: in tests
